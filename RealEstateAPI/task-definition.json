{
  "family": "real-estate-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::592894502947:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "real-estate-api",
      "image": "592894502947.dkr.ecr.us-east-1.amazonaws.com/real-estate-api:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "value": "Server=real-estate-db.c8jqo84sqtq1.us-east-1.rds.amazonaws.com;Database=RealEstateDB;User ID=admin;Password=real-estate-db;TrustServerCertificate=True;MultipleActiveResultSets=False;Encrypt=False"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/real-estate-api-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}